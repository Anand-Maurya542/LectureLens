# ==============================================================================
# LectureLens Environment Configuration
# ==============================================================================

# Application
APP_ENV=development
SECRET_KEY=lecturelens_super_secret_jwt_key_replace_in_production_32bytes_min
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MongoDB Atlas Configuration
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=lecturelens_db


# Storage
MEDIA_UPLOAD_DIR=./data/uploads

# Vector Search Configuration
ATLAS_VECTOR_INDEX_NAME=vector_index
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384

# Whisper ASR Configuration
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

